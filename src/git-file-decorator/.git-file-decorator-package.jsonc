{
  "contributes": {
    "commands": [
      {
        "command": "vstoys.git.fileDecorator.refresh",
        "category": "VsToys",
        "title": "File Decorator: Refresh Decorations - (VsToys)"
      }
    ],
    "colors": [
      {
        "id": "vstoys.gitFileDecorator.changedForeground",
        "description": "Color of files the current branch changed since it split off the target branch (Git File Decorator).",
        "defaults": {
          "dark": "#FFFFFF",
          "light": "#000000",
          "highContrast": "#FFFFFF",
          "highContrastLight": "#000000"
        }
      }
    ],
    "configuration": {
      "properties": {
        "vstoys.git.fileDecorator.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable the File Decorator module in VSCode Toys",
          "order": 5000
        },
        "vstoys.git.fileDecorator.enableBadge": {
          "type": "boolean",
          "default": true,
          "description": "Enable badge for file decorations",
          "order": 5001
        },
        "vstoys.git.fileDecorator.enableColor": {
          "type": "boolean",
          "default": true,
          "description": "Color decorated files with the vstoys.gitFileDecorator.changedForeground theme color (customizable via workbench.colorCustomizations).",
          "order": 5002
        },
        "vstoys.git.fileDecorator.autoDetectDefaultBranch": {
          "type": "boolean",
          "default": true,
          "description": "Compare against the remote's default branch (refs/remotes/origin/HEAD, e.g. origin/main). Falls back to Target Branch when the repository has none.",
          "order": 5004
        },
        "vstoys.git.fileDecorator.targetBranch": {
          "type": "string",
          "default": "main",
          "description": "Branch to compare against when auto-detect is off or finds nothing. Files the current branch changed since it split off this branch get decorated. Any git ref works, e.g. main or origin/develop.",
          "ignoreSync": true,
          "order": 5005
        }
      }
    }
  }
}
